# Copy to .env and fill in. Never commit .env.
# See docs/APIS_AND_ACCOUNTS.md for where to get each key.

# Google AI Studio (page reading + diagram descriptions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# comma-separated; each model has its own free daily quota, tried in order
GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash

# Groq (rewrite, Fact Guard, glossary, summary, quiz, speech-to-text)
GROQ_API_KEY=
GROQ_REWRITE_MODEL=qwen/qwen3.8-27b
GROQ_FACTGUARD_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech (edge-tts, no key)
TTS_URDU_VOICE=ur-PK-UzmaNeural
TTS_ENGLISH_VOICE=en-US-AriaNeural

# App
DEMO_MODE=false
CACHE_DIR=
MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMPT_VERSION=v1

# Frontend (put in frontend/.env.local)
# VITE_API_BASE_URL=http://localhost:8000
